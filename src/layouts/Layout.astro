---
import '../styles/global.css';
import AmbientGlow from '../components/common/AmbientGlow.astro';
import Header from '../components/layout/Header.astro';
import Lightbox from '../components/common/Lightbox.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Miguel Angel Aranguren Ramirez | Desarrollador Fullstack Remoto',
  description = 'Portafolio de Miguel Angel Aranguren Ramirez, Desarrollador Fullstack especializado en Python, TypeScript, SQL, React y arquitecturas serverless. Estudiante de Ing. de Sistemas (UNEXPO) basado en Caracas, disponible para roles remotos.',
  image = '/og-image.png',
  canonical
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://miguel19x.github.io/Portafolio';
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;

// Structured Data Schema.org (Google ProfilePage & Person & WebSite - estrictamente sin FAQ)
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonicalURL}#profilepage`,
      "url": canonicalURL,
      "name": title,
      "description": description,
      "isPartOf": {
        "@type": "WebSite",
        "@id": `${siteUrl}/#website`,
        "url": `${siteUrl}/`,
        "name": "Miguel Angel Aranguren Ramirez | Portafolio Profesional",
        "description": description,
        "inLanguage": ["es", "en"]
      },
      "about": {
        "@id": `${siteUrl}/#person`
      },
      "mainEntity": {
        "@id": `${siteUrl}/#person`
      }
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Miguel Angel Aranguren Ramirez",
      "alternateName": "Miguel Aranguren",
      "url": `${siteUrl}/`,
      "image": socialImageURL,
      "jobTitle": "Desarrollador Fullstack",
      "description": "Desarrollador Fullstack enfocado en sistemas donde la consistencia de datos, la automatización determinista y el rendimiento importan. Especialista en Python, TypeScript, React, SQL y Cloudflare Workers.",
      "sameAs": [
        "https://github.com/Miguel19x",
        "https://linkedin.com/in/miguela19x"
      ],
      "knowsAbout": [
        "Desarrollo Fullstack",
        "Python",
        "TypeScript",
        "React",
        "PostgreSQL",
        "SQL",
        "Pipelines ETL",
        "Cloudflare Workers",
        "Arquitecturas Serverless",
        "Astro",
        "Tailwind CSS",
        "Docker"
      ],
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Universidad Nacional Experimental Politécnica Antonio José de Sucre (UNEXPO)"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Caracas",
        "addressCountry": "VE"
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary SEO Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="author" content="Miguel Angel Aranguren Ramirez" />
  <meta name="generator" content={Astro.generator} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  
  <!-- Canonical & Language Alternates -->
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang="es" href={canonicalURL} />
  <link rel="alternate" hreflang="en" href={canonicalURL} />
  <link rel="alternate" hreflang="x-default" href={canonicalURL} />
  
  <!-- Theme Color para Navegadores Móviles -->
  <meta name="theme-color" content="#090a0f" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
  <meta property="og:type" content="profile" />
  <meta property="og:site_name" content="Miguel Angel Aranguren Ramirez | Portafolio" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:image:secure_url" content={socialImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="Miguel Angel Aranguren Ramirez - Desarrollador Fullstack (Python & TypeScript)" />
  <meta property="og:locale" content="es_VE" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta property="profile:first_name" content="Miguel Angel" />
  <meta property="profile:last_name" content="Aranguren Ramirez" />
  <meta property="profile:username" content="Miguel19x" />

  <!-- Twitter Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageURL} />
  <meta name="twitter:image:alt" content="Miguel Angel Aranguren Ramirez - Desarrollador Fullstack (Python & TypeScript)" />

  <!-- Google Fonts: Preconnect & Asynchronous Non-Render-Blocking Loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    media="print"
    onload="this.onload=null;this.removeAttribute('media')"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </noscript>

  <!-- Google Structured Data (JSON-LD Schema.org) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  <!-- Theme detection script (previene flash de tema incorrecto) -->
  <script is:inline>
    (function() {
      try {
        const saved = localStorage.getItem('portfolio-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (_) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
</head>
<body id="top" class="relative min-h-screen selection:bg-orange-500 selection:text-white">
  <!-- Dynamic ambient lights & grid overlay -->
  <AmbientGlow />

  <!-- Persistent Floating Header -->
  <Header />

  <!-- Main Content Page -->
  <slot />

  <!-- Modal Lightbox para Ampliación de Capturas -->
  <Lightbox />

  <!-- Client-side Interactive Modules -->
  <script>
    import { initScrollytelling } from '../scripts/scrollytelling';
    import { initCreativeCanvas } from '../scripts/creativeCanvas';
    import { initProjectsAccordion } from '../scripts/projectsAccordion';
    import { initLightbox } from '../scripts/lightbox';
    import { initHeroSpecCard } from '../scripts/heroSpecCard';
    import { initI18n } from '../i18n';
    import { initTheme } from '../scripts/theme';
    import { initHeaderNav } from '../scripts/headerNav';
    import { initExperienceCounter } from '../scripts/experienceCounter';

    // Inicializar de forma ordenada separando fases críticas y no críticas
    document.addEventListener('DOMContentLoaded', () => {
      // Fase 1: Módulos fundamentales inmediatos (cero reflows síncronos)
      initTheme();
      initI18n();
      initHeaderNav();

      // Fase 2: Coordinación visual diferida al siguiente frame para erradicar layout thrashing
      requestAnimationFrame(() => {
        initScrollytelling();
        initHeroSpecCard();
        initProjectsAccordion();
        initExperienceCounter();

        // Fase 3: Módulos interactivos secundarios e idle
        const scheduleIdle = window.requestIdleCallback || ((cb: () => void) => setTimeout(cb, 60));
        scheduleIdle(() => {
          initCreativeCanvas();
          initLightbox();
        });
      });
    });
  </script>
</body>
</html>
