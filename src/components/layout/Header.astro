---
import { NAV_LINKS, PERSONAL_INFO } from '../../data/navigation';

const navI18nMap: Record<string, string> = {
  'sobre-mi': 'nav.about',
  'proyectos': 'nav.projects',
  'habilidades': 'nav.skills',
  'trayectoria': 'nav.experience',
  'contacto': 'nav.contact',
};
---

<header class="fixed top-2.5 sm:top-4 left-1/2 -translate-x-1/2 z-50 w-[92vw] sm:w-[88vw] lg:w-fit lg:max-w-[95vw] box-border">
  <nav class="site-header-nav box-border relative flex items-center justify-between gap-2.5 sm:gap-3.5 lg:gap-5 px-3.5 sm:px-5 lg:px-6 py-2 sm:py-2.5 rounded-2xl bg-[#090b10]/90 backdrop-blur-xl border border-white/10 shadow-2xl transition-all duration-300 min-h-13 w-full">
    <!-- Dev identity badge (Left) -->
    <a href="#hero" class="flex items-center gap-2 sm:gap-2.5 group shrink-0 min-w-0" aria-label="miguel.aranguren - Ir al inicio">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 pulse-dot shrink-0"></span>
      <div class="flex items-baseline gap-1.5 xl:gap-2 truncate">
        <span class="font-mono-code text-xs font-semibold tracking-wider text-slate-200 brand-username whitespace-nowrap">{PERSONAL_INFO.username}</span>
        <span class="hidden xl:inline font-mono-code text-[11px] text-slate-400 brand-tagline whitespace-nowrap" data-i18n="nav.brandSub">{PERSONAL_INFO.tagline}</span>
      </div>
    </a>

    <!-- Quick section jump track with live dynamic active indicators (Desktop Center) -->
    <div class="hidden lg:flex items-center justify-center gap-0.5 xl:gap-1 font-mono-code text-xs shrink-0 mx-1.5 xl:mx-3">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          data-nav={link.dataNav}
          data-i18n={navI18nMap[link.dataNav]}
          class="nav-scroller-pill px-2 xl:px-2.5 py-1 rounded-lg border border-transparent text-slate-400 hover:text-white hover:bg-white/5 transition-all duration-200 whitespace-nowrap text-[11px] xl:text-xs font-medium"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Actions: Lang Toggle + Theme Toggle + Mobile Menu + Action CTA (Right) -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
      <button
        id="lang-toggle"
        class="lang-toggle-btn group flex items-center gap-1 px-2 py-1.5 rounded-lg border border-transparent text-xs font-mono-code text-slate-400 hover:text-white hover:bg-white/5 transition-all duration-200 cursor-pointer"
        aria-label="Switch to English"
        title="Cambiar idioma / Switch language"
      >
        <svg class="w-3.5 h-3.5 transition-colors shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="lang-code font-bold tracking-wider text-[11px] sm:text-xs" id="lang-code-indicator">EN</span>
      </button>

      <button
        id="theme-toggle"
        class="theme-toggle-btn flex items-center justify-center w-8 h-8 rounded-lg border border-transparent text-slate-400 hover:text-white hover:bg-white/5 transition-all duration-200 cursor-pointer group shrink-0"
        aria-label="Cambiar tema de color"
        title="Alternar modo claro/oscuro"
      >
        <svg class="w-4 h-4 text-amber-400 group-hover:text-amber-300 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>

      <!-- Botón de apertura de menú en pantallas móviles (< lg) -->
      <button
        id="mobile-menu-toggle"
        class="mobile-menu-btn lg:hidden flex items-center justify-center w-8 h-8 rounded-lg border border-transparent text-slate-400 hover:text-white hover:bg-white/5 transition-all duration-200 cursor-pointer shrink-0"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <div class="w-4 h-4 relative flex items-center justify-center" aria-hidden="true">
          <span class="hamburger-bar block absolute w-full h-0.5 bg-current rounded-full"></span>
          <span class="hamburger-bar block absolute w-full h-0.5 bg-current rounded-full"></span>
          <span class="hamburger-bar block absolute w-full h-0.5 bg-current rounded-full"></span>
        </div>
      </button>

      <!-- Botón de acción destacado "Hablemos" con margen interior seguro -->
      <a href="#contacto" class="btn-brand-accent hidden sm:inline-flex px-3 py-1.5 rounded-xl text-xs font-semibold tracking-wide items-center gap-1.5 shrink-0 whitespace-nowrap">
        <span data-i18n="nav.cta">Hablemos</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Barra de progreso de lectura / scroll integrada en la base del header -->
    <div
      class="header-scroll-track absolute bottom-0 left-0 right-0 h-0.5 overflow-hidden rounded-b-2xl pointer-events-none"
      aria-hidden="true"
    >
      <div
        id="header-scroll-progress"
        class="header-scroll-progress-bar h-full w-full bg-(--section-tint) shadow-[0_0_8px_var(--section-tint)]"
      ></div>
    </div>
  </nav>

  <!-- Panel desplegable interactivo para dispositivos móviles y tablets (< lg) -->
  <div
    id="mobile-nav-drawer"
    class="mobile-nav-panel hidden lg:hidden mt-2 p-3 sm:p-4 rounded-2xl bg-[#090b10]/95 backdrop-blur-2xl border border-white/10 shadow-2xl transition-all duration-300 origin-top overflow-hidden"
    aria-hidden="true"
  >
    <div class="flex flex-col gap-1 font-mono-code text-xs">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          data-nav={link.dataNav}
          class="mobile-nav-link nav-scroller-pill flex items-center justify-between px-3.5 py-2.5 rounded-xl border border-transparent text-slate-300 hover:text-white hover:bg-white/5 transition-all duration-200"
        >
          <span class="mobile-nav-label font-medium" data-i18n={navI18nMap[link.dataNav]}>{link.label}</span>
          <span class="mobile-nav-arrow text-slate-400 font-bold transition-transform duration-200">→</span>
        </a>
      ))}

      <!-- Pie del menú móvil con disponibilidad y CTA -->
      <div class="pt-2.5 mt-1 border-t border-white/10 flex items-center justify-between">
        <span class="text-[11px] text-slate-400 font-mono-code truncate max-w-[55%]" data-i18n="hero.availability">{PERSONAL_INFO.availability}</span>
        <a
          href="#contacto"
          class="mobile-cta-link btn-brand-accent px-3.5 py-1.5 rounded-xl text-xs font-semibold tracking-wide flex items-center gap-1 shrink-0"
        >
          <span data-i18n="nav.cta">Hablemos</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
