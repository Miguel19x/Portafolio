---
import { ABOUT_DATA } from '../../data/about';
---

<section id="sobre-mi" data-section="sobre-mi" class="content-section w-full relative z-10 overflow-hidden">
  <!-- Anchor alias para navegación técnica // 01. Enfoque -->
  <div id="enfoque" class="absolute top-0 pointer-events-none" aria-hidden="true"></div>
  <div class="site-container w-full flex flex-col px-4 sm:px-6 lg:px-8 max-w-6xl">
    
    <!-- Section header -->
    <div class="section-header-mb">
      <div class="inline-flex items-center gap-2 font-mono-code text-xs tracking-wider text-amber-300 uppercase mb-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span data-i18n="about.tag">{ABOUT_DATA.tag}</span>
      </div>
      <h2 class="text-fluid-headline font-extrabold text-white tracking-tight wrap-break-word" data-i18n="about.title">
        {ABOUT_DATA.title}
      </h2>
    </div>

    <!-- Main Content Grid equilibrado verticalmente -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-[clamp(0.75rem,1.8vw,1.75rem)] items-stretch">
      
      <!-- Narrative text card -->
      <div class="lg:col-span-7 p-3.5 sm:p-6 lg:p-7 rounded-2xl bg-[#140c09]/80 border border-amber-900/40 backdrop-blur-xl flex flex-col justify-between h-full narrative-text">
        <div class="space-y-3 sm:space-y-4 text-slate-300 text-xs sm:text-sm leading-relaxed text-editorial-justify">
          <p data-i18n-html="about.p1" set:html={ABOUT_DATA.paragraphs[0]} />
          <p data-i18n-html="about.p2" set:html={ABOUT_DATA.paragraphs[1]} />
        </div>

        <div class="about-tags-container pt-2.5 sm:pt-3 mt-3 sm:mt-4 border-t border-amber-900/40 flex flex-wrap gap-1.5 sm:gap-2">
          <span class="about-tag px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded-md sm:rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20" data-i18n="about.badge1">Ingeniería de Sistemas (UNEXPO)</span>
          <span class="about-tag px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded-md sm:rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20" data-i18n="about.badge2">Testing & TDD (PyTest / Vitest)</span>
          <span class="about-tag px-1.5 sm:px-2.5 py-0.5 sm:py-1 rounded-md sm:rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20" data-i18n="about.badge3">Clean Architecture & Serverless</span>
        </div>
      </div>

      <!-- 3 Pillars list -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-2.5 sm:gap-3 h-full">
        {ABOUT_DATA.pillars.map((pillar, pIdx) => (
          <div class="flex-1 p-3.5 sm:p-4 rounded-xl bg-[#1a0f0a]/90 border border-amber-800/30 hover:border-amber-600/50 transition-all duration-300 group flex flex-col justify-center">
            <div class="flex items-center gap-2.5 mb-1">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 group-hover:bg-amber-500/20 transition-colors shrink-0">
                {pillar.icon === 'math' && (
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {pillar.icon === 'serverless' && (
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                {pillar.icon === 'testing' && (
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                )}
              </div>
              <h3 class="font-bold text-white text-sm sm:text-base tracking-tight" data-i18n={`about.pillar${pIdx + 1}Title`}>{pillar.title}</h3>
            </div>
            <p class="text-xs text-amber-200/70 leading-relaxed sm:pl-10 mt-1 text-editorial-justify" data-i18n={`about.pillar${pIdx + 1}Desc`}>
              {pillar.description}
            </p>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .about-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  @media (min-width: 640px) {
    .about-tags-container {
      gap: 0.5rem;
    }
  }

  .about-tag {
    font-family: var(--font-mono);
    font-size: clamp(0.48rem, 2.05vw, 0.75rem);
    letter-spacing: -0.035em;
    line-height: 1.25;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }

  @media (min-width: 640px) {
    .about-tag {
      font-size: 0.75rem;
      letter-spacing: normal;
      line-height: 1.5;
    }
  }
</style>

