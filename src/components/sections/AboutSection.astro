---
import { ABOUT_DATA } from '../../data/about';
---

<section id="sobre-mi" data-section="sobre-mi" class="content-section w-full relative z-10 overflow-hidden">
  <!-- Anchor alias para navegación técnica // 01. Enfoque -->
  <div id="enfoque" class="absolute top-0 pointer-events-none" aria-hidden="true"></div>
  <div class="site-container w-full flex flex-col px-4 sm:px-6 lg:px-8 max-w-6xl">
    
    <!-- Section header con el mismo espaciado y ritmo que las demás secciones -->
    <div class="section-header-mb">
      <div class="inline-flex items-center gap-2 font-mono-code text-xs tracking-wider text-amber-300 uppercase mb-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        <span data-i18n="about.tag">{ABOUT_DATA.tag}</span>
      </div>
      <h2 class="text-fluid-headline font-extrabold text-slate-100 tracking-tight wrap-break-word" data-i18n="about.title">
        {ABOUT_DATA.title}
      </h2>
    </div>

    <!-- Bento Asimétrico de Taller de Ingeniería (Alineación natural, sin centrado vertical artificial) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-2.5 sm:gap-3.5 lg:gap-4 items-stretch">
      
      <!-- Card Principal (Editorial & Criterio - 7 cols) -->
      <div class="about-editorial-card lg:col-span-7 p-3.5 sm:p-4.5 lg:p-5 rounded-2xl bg-[#140c09]/85 border border-amber-900/40 backdrop-blur-xl flex flex-col justify-between transition-all duration-300 hover:border-amber-700/50">
        <div class="space-y-2.5 sm:space-y-3 text-slate-300 text-xs sm:text-sm leading-relaxed text-editorial-justify">
          <p data-i18n-html="about.p1" set:html={ABOUT_DATA.paragraphs[0]} />
          <p data-i18n-html="about.p2" set:html={ABOUT_DATA.paragraphs[1]} />

          <!-- Cita técnica compacta en una sola franja mono -->
          <div class="about-quote-box p-2 sm:p-2.5 rounded-lg bg-amber-500/4 border-l-2 border-amber-500/60 font-mono-code text-[11px] sm:text-xs text-amber-200/90 italic leading-snug">
            <span data-i18n="about.quote">{ABOUT_DATA.quote}</span>
          </div>
        </div>

        <div class="about-tags-container pt-2.5 mt-2.5 border-t border-amber-900/40 flex flex-wrap gap-1.5 sm:gap-2">
          {ABOUT_DATA.badges.map((badge, idx) => (
            <span class="about-tag px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-md sm:rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/20 transition-all duration-200 hover:scale-[1.02] cursor-default" data-i18n={`about.badge${idx + 1}`}>
              {badge}
            </span>
          ))}
        </div>
      </div>

      <!-- Columna Lateral Asimétrica (Field Notes + Reglas de Taller - 5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between gap-2.5 sm:gap-3 h-full">
        
        <!-- Tarjeta 1: Lección de Campo (Datos en el Mundo Real) -->
        <div class="field-note-card p-3 sm:p-3.5 rounded-xl bg-[#180e0a]/90 border border-amber-800/40 hover:border-amber-600/60 transition-all duration-300 group flex flex-col justify-between flex-1">
          <div>
            <div class="flex items-center justify-between gap-2 mb-1.5 pb-1 border-b border-amber-900/30 font-mono-code text-[10px]">
              <span class="field-note-tag text-amber-400/90 tracking-wider flex items-center gap-1.5" data-i18n="about.fieldNoteTag">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                {ABOUT_DATA.fieldNote.tag}
              </span>
            </div>
            <h3 class="font-bold text-slate-100 text-xs sm:text-sm tracking-tight mb-1" data-i18n="about.fieldNoteTitle">
              {ABOUT_DATA.fieldNote.title}
            </h3>
            <p class="field-note-desc text-[11px] sm:text-xs text-amber-200/75 leading-relaxed text-editorial-justify" data-i18n-html="about.fieldNoteDesc" set:html={ABOUT_DATA.fieldNote.description} />
          </div>

          <div class="field-note-badge mt-2 pt-1.5 border-t border-amber-900/30 flex items-center gap-1.5 font-mono-code text-[10px] text-emerald-400">
            <svg class="w-3 h-3 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span data-i18n="about.fieldNoteBadge">{ABOUT_DATA.fieldNote.badge}</span>
          </div>
        </div>

        <!-- Tarjeta 2: Mis No Negociables en Código (Auditoría / PR Checklist) -->
        <div class="manifesto-card p-3 sm:p-3.5 rounded-xl bg-[#120a06]/95 border border-amber-900/30 hover:border-amber-700/50 transition-all duration-300 flex flex-col justify-between font-mono-code flex-1">
          <div class="flex items-center justify-between gap-2 mb-1.5 pb-1 border-b border-amber-900/30 text-[10px]">
            <span class="manifesto-tag text-slate-400 uppercase tracking-wider flex items-center gap-1.5" data-i18n="about.rulesTag">
              <svg class="w-3 h-3 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              MANIFIESTO // MIS NO NEGOCIABLES
            </span>
            <span class="manifesto-pill text-amber-400/70 text-[9px] px-1.5 py-0.5 rounded bg-amber-500/10">PR CHECK</span>
          </div>

          <div class="space-y-1.5">
            {ABOUT_DATA.rules.map((rule, rIdx) => (
              <div class="flex items-baseline gap-1.5 text-[11px] leading-tight">
                <span class="manifesto-rule-num text-orange-400 font-bold shrink-0">{rule.num}</span>
                <div>
                  <span class="manifesto-rule-title text-slate-100 font-medium" data-i18n={`about.rule${rIdx + 1}Title`}>{rule.title}:</span>
                  <span class="manifesto-rule-desc text-slate-400 text-[10.5px] ml-1" data-i18n={`about.rule${rIdx + 1}Desc`}>{rule.desc}</span>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<style>
  .about-tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  @media (min-width: 640px) {
    .about-tags-container {
      gap: 0.5rem;
    }
  }

  .about-tag {
    font-family: var(--font-mono);
    font-size: clamp(0.48rem, 2.05vw, 0.75rem);
    letter-spacing: -0.035em;
    line-height: 1.25;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }

  @media (min-width: 640px) {
    .about-tag {
      font-size: 0.75rem;
      letter-spacing: normal;
      line-height: 1.5;
    }
  }
</style>
