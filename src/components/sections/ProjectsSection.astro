---
import { ALL_PROJECTS } from '../../data/projects';
import ProjectAccordion from '../common/ProjectAccordion.astro';
---

<section id="proyectos" data-section="proyectos" class="content-section w-full relative z-10">
  <div class="site-container w-full flex flex-col px-4 sm:px-8 lg:px-12 max-w-7xl">
    
    <!-- Section header -->
    <div class="section-header-mb">
      <div class="inline-flex items-center gap-2 font-mono-code text-xs tracking-wider text-cyan-400 uppercase mb-1.5">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span data-i18n="projects.tag">// 02. Proyectos & Case Studies</span>
      </div>
      <h2 class="text-fluid-headline font-extrabold text-white tracking-tight wrap-break-word" data-i18n="projects.title">
        Trabajo Real y Decisiones de Arquitectura
      </h2>
    </div>

    <!-- Acordeón Vertical Desplegable de Case Studies -->
    <div 
      class="projects-accordion-list" 
      id="projects-accordion" 
      role="region" 
      aria-label="Proyectos y Case Studies de Miguel Angel Aranguren"
    >
      {ALL_PROJECTS.map((project, index) => (
        <ProjectAccordion 
          project={project} 
          index={index} 
          total={ALL_PROJECTS.length} 
        />
      ))}
    </div>

  </div>
</section>
