---
import { SKILL_CATEGORIES } from '../../data/skills';

const categoryTitleMap: Record<string, string> = {
  frontend: 'skills.catFrontend',
  backend: 'skills.catBackend',
  cloud: 'skills.catCloud',
};

const skillKeyMap: Record<string, string> = {
  'React': 'skills.reactCtx',
  'TypeScript': 'skills.tsCtx',
  'JavaScript (ES6+)': 'skills.jsCtx',
  'HTML5 & CSS3': 'skills.htmlCssCtx',
  'Astro': 'skills.astroCtx',
  'Python': 'skills.pythonCtx',
  'SQL': 'skills.sqlCtx',
  'MongoDB / NoSQL': 'skills.mongoCtx',
  'REST APIs': 'skills.restCtx',
  'Java': 'skills.javaCtx',
  'Cloudflare Workers': 'skills.cfCtx',
  'Git & GitHub': 'skills.gitCtx',
  'Docker': 'skills.dockerCtx',
  'Testing (PyTest & Vitest)': 'skills.testsCtx',
  'CI/CD (GitHub Actions)': 'skills.cicdCtx',
};
---

<section id="habilidades" data-section="habilidades" class="content-section w-full relative z-10 overflow-hidden">
  <div class="site-container w-full flex flex-col px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10">
    
    <!-- Section header -->
    <div class="section-header-mb">
      <div class="inline-flex items-center gap-2 font-mono-code text-xs tracking-wider text-emerald-400 uppercase mb-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span data-i18n="skills.tag">// 03. Competencias Técnicas</span>
      </div>
      <h2 class="text-fluid-headline font-extrabold text-white tracking-tight wrap-break-word" data-i18n="skills.title">
        Habilidades Estructuradas por Entorno.
      </h2>
    </div>

    <!-- Mobile Environment Selector Tabs (Reduce más de 1000px de scroll vertical en smartphone) -->
    <div 
      class="flex md:hidden items-center justify-between p-1 rounded-xl bg-emerald-950/70 border border-emerald-900/50 backdrop-blur-md mb-2.5" 
      role="tablist" 
      aria-label="Entornos de habilidades técnicas"
    >
      {SKILL_CATEGORIES.map((cat, idx) => (
        <button
          type="button"
          role="tab"
          id={`tab-${cat.id}`}
          aria-selected={idx === 0 ? "true" : "false"}
          aria-controls={`panel-${cat.id}`}
          data-skill-target={cat.id}
          class={`skill-tab-btn flex-1 py-1.5 px-2 rounded-lg text-xs font-mono-code font-semibold transition-all duration-200 text-center select-none cursor-pointer ${
            idx === 0
              ? 'active bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-xs'
              : 'text-slate-400 hover:text-white hover:bg-white/5 border border-transparent'
          }`}
        >
          {cat.id === 'frontend' && 'Frontend'}
          {cat.id === 'backend' && 'Backend'}
          {cat.id === 'cloud' && 'Cloud & Ops'}
        </button>
      ))}
    </div>

    <!-- Skills Grid (Desktop: 3 Columnas Bento Grid / Móvil: Vista de Panel Activo) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-2 sm:gap-2.5 lg:gap-3 items-stretch">
      {SKILL_CATEGORIES.map((category) => (
        <div 
          id={`panel-${category.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${category.id}`}
          data-skill-panel={category.id}
          class={`skill-card-panel p-2.5 sm:p-3 lg:px-3.5 lg:py-2.5 rounded-xl sm:rounded-2xl bg-[#0e1e17]/80 border border-emerald-900/40 backdrop-blur-xl hover:border-emerald-500/50 transition-all duration-300 flex-col justify-between group ${category.id === 'frontend' ? 'flex' : 'hidden md:flex'}`}
        >
          <div>
            <!-- Category Header -->
            <div class="flex items-center gap-2 pb-1.5 mb-1.5 sm:pb-2 sm:mb-2 border-b border-emerald-900/40">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 group-hover:bg-emerald-500/20 transition-colors shrink-0">
                {category.icon === 'frontend' && (
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {category.icon === 'backend' && (
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2 1.5 3 3.5 3h9c2 0 3.5-1 3.5-3V7c0-2-1.5-3-3.5-3h-9C5.5 4 4 5 4 7zM9 9h6M9 13h6M9 17h4" />
                  </svg>
                )}
                {category.icon === 'cloud' && (
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
                  </svg>
                )}
              </div>
              <h3 class="font-bold text-sm sm:text-base text-white tracking-tight" data-i18n={categoryTitleMap[category.id]}>{category.title}</h3>
            </div>

            <!-- Skill Items: Fichas Modulares Compactadas -->
            <div class="space-y-1">
              {category.skills.map((skill) => (
                <div class="py-1 px-2 sm:px-2.5 rounded-lg bg-emerald-950/20 border border-emerald-900/30 hover:border-emerald-500/35 transition-colors group/item">
                  <div class="flex items-center gap-1.5">
                    <span class="text-emerald-400 font-mono-code text-[10px]">▸</span>
                    <h4 class="text-xs font-semibold text-white group-hover/item:text-emerald-300 transition-colors">
                      {skill.name}
                    </h4>
                  </div>
                  <p class="text-[10px] sm:text-[11px] text-emerald-200/70 leading-tight sm:leading-snug mt-0.5 pl-3.5 text-editorial-justify" data-i18n={skillKeyMap[skill.name]}>
                    {skill.context}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-1.5 mt-1.5 sm:pt-2 sm:mt-2 border-t border-emerald-900/30 font-mono-code text-[10px] text-emerald-400/80 flex items-center justify-between">
            <span data-i18n="skills.verified">Producción verificada</span>
            <span class="text-emerald-500/40 font-mono text-[9px] sm:text-[10px]">VERIFIED // ACTIVE</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>



<script>
  function initSkillsTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.skill-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('.skill-card-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-skill-target');
        if (!target) return;

        // Actualizar estado activo en botones de pestañas
        tabs.forEach((t) => {
          const isSelected = t === tab;
          t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
          if (isSelected) {
            t.classList.add('active', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'shadow-xs');
            t.classList.remove('text-slate-400', 'border-transparent');
          } else {
            t.classList.remove('active', 'bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40', 'shadow-xs');
            t.classList.add('text-slate-400', 'border-transparent');
          }
        });

        // Alternar visualización del panel en móvil
        panels.forEach((p) => {
          const panelTarget = p.getAttribute('data-skill-panel');
          if (panelTarget === target) {
            p.classList.remove('hidden');
            p.classList.add('flex');
          } else {
            p.classList.add('hidden');
            p.classList.remove('flex');
          }
        });
      });
    });
  }

  // Inicializar al cargar el DOM o en navegación
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkillsTabs);
  } else {
    initSkillsTabs();
  }
</script>
