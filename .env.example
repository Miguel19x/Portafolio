# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PORTAFOLIO
# =============================================================================
# Copia este archivo a `.env` y configura tus valores personales:
# cp .env.example .env

# 1. FRONTEND (Vite - Variables públicas con prefijo VITE_)
# -----------------------------------------------------------------------------
# Site Key de Cloudflare Turnstile (Obtén la tuya en dash.cloudflare.com > Turnstile):
# Clave oficial de prueba (siempre aprueba): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Ruta del endpoint para procesar envíos de contacto
VITE_CONTACT_API_URL=/api/contact

# Correo electrónico de contacto para la interfaz
VITE_CONTACT_EMAIL=miguelaranguren19x@outlook.com

# 2. BACKEND / WORKER (Secretos de Cloudflare)
# -----------------------------------------------------------------------------
# Estos valores se configuran en Cloudflare Dashboard o con `wrangler secret put`:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_tu_api_key_aqui
CONTACT_DESTINATION_EMAIL=tu_correo@dominio.com
ALLOWED_ORIGINS=https://tudominio.com,http://localhost:5173
